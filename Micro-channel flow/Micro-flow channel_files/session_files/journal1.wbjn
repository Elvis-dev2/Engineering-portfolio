SetScriptVersion(Version="24.1.144")
template1 = GetTemplate(TemplateName="Fluid Flow with Fluent Meshing")
system1 = template1.CreateSystem()
system1.DisplayText = "Micro channel flow"
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsDiscoveryGeometry=True)
Update()
tGridCADImportOptions1 = GetDataEntity("/Mesh/TGridCADImportOptions:TGridCADImportOptions")
tGridCADImportOptions1.Units = "nm"
setup1 = system1.GetContainer(ComponentName="Setup")
