esel,s,type,,2
nsle
sfe,all,1,pres,1,0.
sfe,all,2,pres,1,-999999.761581475
nsel,all
esel,all
/nopr
/gopr
nsub,1,1,1
time,1.
outres,erase
outres,all,none
outres,nsol,all,
outres,rsol,all
outres,eangl,all
outres,etmp,all
outres,veng,all
outres,strs,all,
