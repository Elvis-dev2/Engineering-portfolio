# encoding: utf-8
# 2024 R1
SetScriptVersion(Version="24.1.144")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
material1 = engineeringData1.GetMaterial(Name="Structural Steel")
material1.SetSuppression(Suppressed=True)
material1.SetSuppression(Suppressed=False)
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
Save(Overwrite=True)
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
matl1 = engineeringData1.CreateMaterial(Name="alu")
matl1.DisplayName = "Aluminium"
matlProp1 = matl1.CreateProperty(
    Name="Density",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp1.SetData(
    Index=-1,
    Variables=["Density"],
    Values=[["2700 [kg m^-3]"]])
matlProp2 = matl1.CreateProperty(
    Name="Tensile Yield Strength",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp2.SetVariableProperty(
    VariableName="Tensile Yield Strength",
    Property="Unit",
    Value="GPa")
matlProp2.SetData(
    Index=-1,
    Variables=["Tensile Yield Strength"],
    Values=[["69 [GPa]"]])
matlProp2.SetVariableProperty(
    VariableName="Tensile Yield Strength",
    Property="Unit",
    Value="MPa")
matlProp2.SetData(
    Variables=["Tensile Yield Strength"],
    Values=[["69000 [MPa]"]])
matlProp2.SetData(
    Variables=["Tensile Yield Strength"],
    Values=[["275 [MPa]"]])
matlProp3 = matl1.CreateProperty(
    Name="Elasticity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp3.BeginBatchUpdate()
matlProp3.SetVariableProperty(
    SheetName="Elasticity",
    SheetQualifiers={"Definition": "", "Behavior": "Isotropic", "Derive from": "Young's Modulus and Poisson's Ratio"},
    VariableName="Young's Modulus",
    Property="Unit",
    Value="GPa")
matlProp3.EndBatchUpdate()
matlProp3.SetData(
    SheetName="Elasticity",
    SheetQualifiers={"Definition": "", "Behavior": "Isotropic", "Derive from": "Young's Modulus and Poisson's Ratio"},
    Index=-1,
    Variables=["Young's Modulus"],
    Values=[["69 [GPa]"]])
matlProp3.SetData(
    SheetName="Elasticity",
    SheetQualifiers={"Definition": "", "Behavior": "Isotropic", "Derive from": "Young's Modulus and Poisson's Ratio"},
    Variables=["Poisson's Ratio"],
    Values=[["0.33"]])
material1.SetSuppression(Suppressed=True)
matl1.SetSuppression(Suppressed=True)
material1.SetSuppression(Suppressed=False)
material1.SetSuppression(Suppressed=True)
matl1.SetSuppression(Suppressed=False)
Save(Overwrite=True)
model1.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
model1.Exit()
model1.Edit()
model1.Exit()
system2 = template1.CreateSystem()
favorites1 = EngData.LoadFavoriteItems()
EngData.EnableFilter(Enable=False)
library1 = EngData.OpenLibrary(
    Name="ANSYS GRANTA Materials Data for Simulation (Sample)",
    Source="Granta_Design_Typical_Materials.xml")
library2 = EngData.OpenLibrary(
    Name="General Materials",
    Source="General_Materials.xml")
material2 = engineeringData1.GetMaterial(Name="Structural Steel 2")
material2.SetSuppression(Suppressed=True)
material2.SetSuppression(Suppressed=False)
material3 = engineeringData1.GetMaterial(Name="Structural Steel 5")
material3.SetSuppression(Suppressed=True)
material4 = engineeringData1.GetMaterial(Name="Structural Steel 4")
material4.SetSuppression(Suppressed=True)
material5 = engineeringData1.GetMaterial(Name="Structural Steel 3")
material5.SetSuppression(Suppressed=True)
material2.SetSuppression(Suppressed=True)
matl1.SetSuppression(Suppressed=True)
material1.SetSuppression(Suppressed=False)
engineeringData2 = system2.GetContainer(ComponentName="Engineering Data")
matl2 = engineeringData2.ImportMaterial(
    Name="Aluminum Alloy",
    Source="General_Materials.xml")
matl3 = engineeringData2.ImportMaterial(
    Name="Structural Steel",
    Source="General_Materials.xml")
EngData.EnableFilter()
EngData.EnableFilter(Enable=False)
matl3.SetSuppression(Suppressed=True)
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsSpaceClaimGeometry=True)
modelComponent2 = system2.GetComponent(Name="Model")
modelComponent2.Refresh()
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
setup1 = system2.GetContainer(ComponentName="Setup")
setup1.Edit()
solution1 = system2.GetContainer(ComponentName="Solution")
solution1.Edit()
results1 = system2.GetContainer(ComponentName="Results")
results1.Edit()
system1.Delete()
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
