# encoding: utf-8
# 2024 R1
SetScriptVersion(Version="24.1.144")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
favorites1 = EngData.LoadFavoriteItems()
library1 = EngData.OpenLibrary(
    Name="General Materials",
    Source="General_Materials.xml")
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
matl1 = engineeringData1.ImportMaterial(
    Name="Aluminum Alloy",
    Source="General_Materials.xml")
library2 = EngData.OpenLibrary(
    Name="General Non-linear Materials",
    Source="General Materials Non-linear.xml")
matl2 = engineeringData1.ImportMaterial(
    Name="Structural Steel NL",
    Source="General Materials Non-linear.xml")
matl3 = engineeringData1.CreateMaterial(Name="Mateial 1")
matlProp1 = matl3.CreateProperty(
    Name="Density",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp1.SetVariableProperty(
    VariableName="Density",
    Property="Unit",
    Value="lb ft^-3")
matlProp1.SetData(
    Index=-1,
    Variables=["Density"],
    Values=[["150 [lb ft^-3]"]])
matlProp1.SetVariableProperty(
    VariableName="Density",
    Property="Unit",
    Value="kg m^-3")
matlProp1.SetData(
    Variables=["Density"],
    Values=[["2402.7695060940209 [kg m^-3]"]])
matlProp2 = matl3.CreateProperty(
    Name="Elasticity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp2.SetVariableProperty(
    VariableName="Young's Modulus",
    Property="Unit",
    Value="psi")
matlProp2.SetData(
    Index=-1,
    Variables=["Young's Modulus"],
    Values=[["5000 [psi]"]])
matlProp2.SetData(
    Variables=["Young's Modulus"],
    Values=[["5000000 [psi]"]])
matlProp2.SetData(
    Variables=["Poisson's Ratio"],
    Values=[["0.2"]])
matlProp3 = matl3.CreateProperty(
    Name="Prony",
    Definition="Shear Relaxation",
    Qualifiers={"Definition": "Shear Relaxation", "Behavior": ""})
matlProp3.SetQualifier(
    Qualifier="Number of Terms",
    Value="3")
matlProp3.SetData(
    SheetName="Prony",
    SheetQualifiers={"Definition": "Shear Relaxation", "Behavior": "", "Number of Terms": "3"},
    Variables=["Relative Moduli(i)"],
    Values=[["0.5"]])
matlProp3.SetData(
    SheetName="Prony",
    SheetQualifiers={"Definition": "Shear Relaxation", "Behavior": "", "Number of Terms": "3"},
    Variables=["Relaxation Time(i)"],
    Values=[["1 [s]"]])
matlProp3.SetData(
    SheetName="Prony",
    SheetQualifiers={"Definition": "Shear Relaxation", "Behavior": "", "Number of Terms": "3"},
    Index=1,
    Variables=["Relative Moduli(i)"],
    Values=[["0.2"]])
matlProp3.SetData(
    SheetName="Prony",
    SheetQualifiers={"Definition": "Shear Relaxation", "Behavior": "", "Number of Terms": "3"},
    Index=1,
    Variables=["Relaxation Time(i)"],
    Values=[["10 [s]"]])
matlProp3.SetData(
    SheetName="Prony",
    SheetQualifiers={"Definition": "Shear Relaxation", "Behavior": "", "Number of Terms": "3"},
    Index=2,
    Variables=["Relative Moduli(i)"],
    Values=[["0.2"]])
matlProp3.SetData(
    SheetName="Prony",
    SheetQualifiers={"Definition": "Shear Relaxation", "Behavior": "", "Number of Terms": "3"},
    Index=2,
    Variables=["Relaxation Time(i)"],
    Values=[["100 [s]"]])
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
matl3.DisplayName = "Material 1"
model1.Edit()
modelComponent1.Update(AllDependencies=True)
model1.Exit()
model1.Edit()
Save(Overwrite=True)
