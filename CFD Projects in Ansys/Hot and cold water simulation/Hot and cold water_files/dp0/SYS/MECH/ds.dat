tref,22.
/wb,mat,start              !  starting to send materials
/com,*********** Send Materials ***********
Temperature = 'TEMP' ! Temperature
MP,DENS,1,2703,	! kg m^-3
MP,C,1,885,	! J kg^-1 C^-1
MP,EX,1,68900000000,	! Pa
MP,NUXY,1,0.33,
